# ---------------------------------------------------------------------------
# woodingben.com - static site (WordPress migration)
# Apache / LiteSpeed (Hostinger shared hosting)
# ---------------------------------------------------------------------------

# ----- 404 -----------------------------------------------------------------
ErrorDocument 404 /404.html

# ----- Security headers ----------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ----- Caching -------------------------------------------------------------
# Long-lived immutable cache for static media under /wp-content/uploads/ and
# site assets under /assets/ (matched by extension); shorter cache for HTML
# and for the sitemap/robots/feed files.
<IfModule mod_headers.c>
  <FilesMatch "\.(jpe?g|png|gif|webp|avif|svg|ico|css|js|mjs|woff2?|ttf|otf|eot|pdf|mp4|webm)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
  <FilesMatch "\.(xml|txt)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>

# ----- Compression ---------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/xhtml+xml application/rss+xml application/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml application/xml application/xhtml+xml application/rss+xml application/javascript application/json image/svg+xml
</IfModule>

# ---------------------------------------------------------------------------
# 301 redirects (exact-match, anchored). SEO continuity with the old
# WordPress/Yoast URLs. Static files under /wp-content/uploads/ are served
# directly and are NOT touched by any rule below.
# ---------------------------------------------------------------------------

# ----- Yoast sitemap URLs -> new static sitemap ----------------------------
RedirectMatch 301 ^/sitemap_index\.xml$ https://woodingben.com/sitemap.xml
RedirectMatch 301 ^/post\-sitemap\.xml$ https://woodingben.com/sitemap.xml
RedirectMatch 301 ^/page\-sitemap\.xml$ https://woodingben.com/sitemap.xml
RedirectMatch 301 ^/category\-sitemap\.xml$ https://woodingben.com/sitemap.xml
RedirectMatch 301 ^/post_tag\-sitemap\.xml$ https://woodingben.com/sitemap.xml
RedirectMatch 301 ^/author\-sitemap\.xml$ https://woodingben.com/sitemap.xml

# ----- Archive URLs (category / tags / author) -----------------------------
RedirectMatch 301 ^/category/php/$ https://woodingben.com/posts/
RedirectMatch 301 ^/tag/api/$ https://woodingben.com/posts/
RedirectMatch 301 ^/tag/google\-scholar/$ https://woodingben.com/posts/
RedirectMatch 301 ^/author/woodingben/$ https://woodingben.com/

# ----- Legacy tool short URLs (live 301s today; mirror them) ----------------
RedirectMatch 301 ^/impact/$ https://woodingben.com/software-tools/impact-software-tool/
RedirectMatch 301 ^/protect/$ https://woodingben.com/software-tools/protect-software-tool/
RedirectMatch 301 ^/software\-tools/protect/$ https://woodingben.com/software-tools/protect-software-tool/

# ----- Feeds ---------------------------------------------------------------
RedirectMatch 301 ^/feed/$ https://woodingben.com/feed.xml
RedirectMatch 301 ^/comments/feed/$ https://woodingben.com/feed.xml
RedirectMatch 301 ^/scraping\-google\-scholar/feed/$ https://woodingben.com/scraping-google-scholar/
RedirectMatch 301 ^/plug\-in\-google\-scholar\-orderer/feed/$ https://woodingben.com/plug-in-google-scholar-orderer/

